{
  "name": "careeros-ai-server",
  "version": "1.0.0",
  "description": "CareerOS AI backend",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "seed:jobs": "node scripts/seedJobs.js",
    "test": "node --test --test-concurrency=1 tests/api.test.js tests/autoApply.test.js tests/resumeIntelligence.test.js",
    "start:ai": "cd ai-service && PYTHONPATH=. venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001",
    "test:ai": "cd ai-service && PYTHONPATH=. venv/bin/pytest tests/ -v"
  },
  "keywords": [
    "careeros",
    "jobs",
    "ai"
  ],
  "author": "Uppara Vinod",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^10.1.4",
    "mongoose": "^8.20.1",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
