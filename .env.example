PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=careeros_ai
JWT_SECRET=change_this_in_production
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Job synchronization
JOB_SYNC_ENABLED=true
JOB_SYNC_INTERVAL_MS=600000
JOB_SYNC_LIMIT=30

# Adzuna
ADZUNA_APP_ID=your_app_id
ADZUNA_APP_KEY=your_app_key
ADZUNA_COUNTRY=in

# JSearch
JSEARCH_API_KEY=your_rapidapi_key

# Remotive
REMOTIVE_ENABLED=true

# Connected Accounts & Integrations
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

INDEED_CLIENT_ID=your_indeed_client_id
INDEED_CLIENT_SECRET=your_indeed_client_secret

GREENHOUSE_API_KEY=your_greenhouse_api_key
LEVER_API_KEY=your_lever_api_key

# Token Encryption at Rest (32-character AES-256 key)
ENCRYPTION_KEY=careeros_secure_aes256_encryption_key_32bytes
